const markers = [
  { id: '1', title: 'Coffee Shop', coordinate: { latitude: 37.78825, longitude: -122.4324 }, description: 'Best espresso in town' },
  { id: '2', title: 'Park', coordinate: { latitude: 37.78925, longitude: -122.4344 }, description: 'Morning jogging spot' },
  { id: '3', title: 'Office', coordinate: { latitude: 37.78725, longitude: -122.4304 }, description: 'Main workspace' },
];

