import { useState } from "react";
import { Text, View } from "react-native";
import { SafeAreaView } from "react-native-safe-area-context";
import * as Notifications from "expo-notifications";
import { Bell, Check, X } from "lucide-react-native";
import { Button } from "../../components/ui/button";

export default function PermissionsScreen() {
  const [status, setStatus] = useState<"pending" | "granted" | "denied">("pending");

  const requestPermission = async () => {
    const { status: permissionStatus } = await Notifications.requestPermissionsAsync();
    setStatus(permissionStatus === "granted" ? "granted" : "denied");
  };

  if (status !== "pending") {
    return (
      <SafeAreaView className="flex-1 bg-background">
        <View className="flex-1 items-center justify-center px-6">
          <View
            className={`h-20 w-20 items-center justify-center rounded-3xl ${
              status === "granted" ? "bg-green-100" : "bg-muted"
            }`}
          >
            {status === "granted" ? (
              <Check size={36} className="text-green-600" />
            ) : (
              <X size={36} className="text-muted-foreground" />
            )}
          </View>
          <Text className="mt-6 text-center text-2xl font-bold text-foreground">
            {status === "granted" ? "Notifications enabled" : "Notifications disabled"}
          </Text>
          <Text className="mt-2 text-center text-muted-foreground">
            {status === "granted"
              ? "You'll stay up to date with everything important."
              : "You can change this anytime in your device settings."}
          </Text>
        </View>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView className="flex-1 bg-background">
      <View className="flex-1 justify-center px-6">
        <View className="items-center">
          <View className="h-20 w-20 items-center justify-center rounded-3xl bg-primary/10">
            <Bell size={36} className="text-primary" />
          </View>
          <Text className="mt-6 text-center text-3xl font-bold text-foreground">
            Stay in the loop
          </Text>
          <Text className="mt-2 text-center text-muted-foreground">
            Allow notifications to get important updates, reminders, and news.
          </Text>
        </View>

        <View className="mt-12 gap-3">
          <Button size="lg" onPress={requestPermission}>
            Allow Notifications
          </Button>
          <Button variant="ghost" size="lg" onPress={() => setStatus("denied")}>
            Not now
          </Button>
        </View>
      </View>
    </SafeAreaView>
  );
}