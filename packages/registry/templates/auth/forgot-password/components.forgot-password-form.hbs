import { useState } from 'react';
import { 
  View, 
  Text, 
  TextInput, 
  Pressable, 
  ActivityIndicator{{#if (eq styling "stylesheet")}}, 
  StyleSheet{{/if}} 
} from 'react-native';
import { useForm, Controller } from 'react-hook-form';
import { zodResolver } from '@hookform/resolvers/zod';
import { z } from 'zod';
{{#if (eq icons "lucide")}}
import { Mail } from 'lucide-react-native';
{{/if}}

{{#if typescript}}
const schema = z.object({
  email: z.string().min(1, 'Email is required').email('Enter a valid email'),
});

type FormData = z.infer<typeof schema>;
{{/if}}

export function ForgotPasswordForm() {
  {{#if typescript}}
  const { control, handleSubmit, formState: { errors } } = useForm<FormData>({
    resolver: zodResolver(schema),
    defaultValues: { email: '' },
  });
  {{else}}
  const schema = z.object({
    email: z.string().min(1, 'Email is required').email('Enter a valid email'),
  });
  const { control, handleSubmit, formState: { errors } } = useForm({
    resolver: zodResolver(schema),
    defaultValues: { email: '' },
  });
  {{/if}}

  const [sent, setSent] = useState(false);
  const [isLoading, setIsLoading] = useState(false);

  const onSubmit = async ({{#if typescript}}data: FormData{{else}}data{{/if}}) => {
    setIsLoading(true);
    try {
      // Replace with your actual reset logic
      // Example: await supabase.auth.resetPasswordForEmail(data.email);
      console.log('Reset request', { email: data.email });
      await new Promise((resolve) => setTimeout(resolve, 1500));
      setSent(true);
    } finally {
      setIsLoading(false);
    }
  };

  if (sent) {
    return (
      <View {{#if (eq styling "nativewind")}}className="items-center rounded-xl bg-green-50 px-4 py-4"{{else}}style={styles.successCard}{{/if}}>
        <Text {{#if (eq styling "nativewind")}}className="text-base font-medium text-green-700"{{else}}style={styles.successText}{{/if}}>
          Check your inbox! We sent a reset link to your email.
        </Text>
      </View>
    );
  }

  return (
    <View {{#if (eq styling "nativewind")}}className="gap-4"{{else}}style={styles.container}{{/if}}>
      <View>
        <Text {{#if (eq styling "nativewind")}}className="mb-1 text-sm font-medium text-gray-700"{{else}}style={styles.label}{{/if}}>
          Email
        </Text>
        <Controller
          control={control}
          name="email"
          render={({ field: { onChange, onBlur, value } }) => (
            <View {{#if (eq styling "nativewind")}}className={`flex-row items-center border rounded-lg px-3 py-3 ${errors.email ? 'border-red-500' : 'border-gray-300'}`}{{else}}style={[styles.inputContainer, errors.email && styles.inputError]}{{/if}}>
              {{#if (eq icons "lucide")}}
              <Mail size={20} color={errors.email ? '#EF4444' : '#6B7280'} />
              {{/if}}
              <TextInput
                placeholder="you@example.com"
                value={value}
                onChangeText={onChange}
                onBlur={onBlur}
                autoCapitalize="none"
                keyboardType="email-address"
                placeholderTextColor="#9CA3AF"
                {{#if (eq styling "nativewind")}}className="flex-1 ml-3 text-gray-900"{{else}}style={styles.input}{{/if}}
              />
            </View>
          )}
        />
        {errors.email && (
          <Text {{#if (eq styling "nativewind")}}className="mt-1 text-sm text-red-500"{{else}}style={styles.errorText}{{/if}}>
            {errors.email.message}
          </Text>
        )}
      </View>

      <Pressable
        onPress={handleSubmit(onSubmit)}
        disabled={isLoading}
        {{#if (eq styling "nativewind")}}className={`py-3 rounded-lg ${isLoading ? 'bg-blue-400' : 'bg-blue-600'}`}{{else}}style={[styles.button, isLoading && styles.buttonDisabled]}{{/if}}
      >
        {isLoading ? (
          <ActivityIndicator color="#FFFFFF" />
        ) : (
          <Text {{#if (eq styling "nativewind")}}className="text-white text-center font-semibold text-base"{{else}}style={styles.buttonText}{{/if}}>
            Send Reset Link
          </Text>
        )}
      </Pressable>
    </View>
  );
}

{{#if (eq styling "stylesheet")}}
const styles = StyleSheet.create({
  container: {
    gap: 16,
  },
  label: {
    marginBottom: 4,
    fontSize: 14,
    fontWeight: '500',
    color: '#374151',
  },
  inputContainer: {
    flexDirection: 'row',
    alignItems: 'center',
    borderWidth: 1,
    borderColor: '#D1D5DB',
    borderRadius: 8,
    paddingHorizontal: 12,
    paddingVertical: 12,
  },
  inputError: {
    borderColor: '#EF4444',
  },
  input: {
    flex: 1,
    marginLeft: 12,
    color: '#111827',
  },
  errorText: {
    marginTop: 4,
    fontSize: 14,
    color: '#EF4444',
  },
  button: {
    paddingVertical: 12,
    borderRadius: 8,
    backgroundColor: '#2563EB',
  },
  buttonDisabled: {
    backgroundColor: '#93C5FD',
  },
  buttonText: {
    color: '#FFFFFF',
    textAlign: 'center',
    fontWeight: '600',
    fontSize: 16,
  },
  successCard: {
    alignItems: 'center',
    borderRadius: 12,
    backgroundColor: '#F0FDF4',
    paddingHorizontal: 16,
    paddingVertical: 16,
  },
  successText: {
    fontSize: 16,
    fontWeight: '500',
    color: '#15803D',
  },
});
{{/if}}