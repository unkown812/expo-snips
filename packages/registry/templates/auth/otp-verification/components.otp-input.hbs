import { useRef, useState } from 'react';
import { 
  Pressable, 
  Text, 
  TextInput, 
  View{{#if (eq styling "stylesheet")}}, 
  StyleSheet{{/if}} 
} from 'react-native';
{{#if (eq icons "lucide")}}
import { RefreshCw } from 'lucide-react-native';
{{/if}}

const OTP_LENGTH = 6;

export function OtpInput() {
  const [code, setCode] = useState('');
  {{#if typescript}}
  const [error, setError] = useState<string | null>(null);
  {{else}}
  const [error, setError] = useState(null);
  {{/if}}
  const inputRef = useRef<TextInput>(null);

  const handleChange = (value: string) => {
    const digits = value.replace(/[^0-9]/g, '').slice(0, OTP_LENGTH);
    setCode(digits);
    setError(null);
  };

  const handleVerify = () => {
    if (code.length < OTP_LENGTH) {
      setError(`Enter the ${OTP_LENGTH}-digit code.`);
      return;
    }
    // Replace with your actual verification logic
    console.log('OTP submitted:', code);
  };

  const handleResend = () => {
    setCode('');
    inputRef.current?.focus();
  };

  return (
    <View {{#if (eq styling "nativewind")}}className="gap-4"{{else}}style={styles.container}{{/if}}>
      <Pressable onPress={() => inputRef.current?.focus()}>
        <View {{#if (eq styling "nativewind")}}className="flex-row justify-between"{{else}}style={styles.boxesRow}{{/if}}>
          {Array.from({ length: OTP_LENGTH }).map((_, i) => {
            const active = code.length === i;
            const filled = Boolean(code[i]);
            return (
              <View
                key={i}
                {{#if (eq styling "nativewind")}}className={`h-14 w-12 items-center justify-center rounded-xl border-2 ${
                  active || filled
                    ? 'border-blue-500 bg-blue-50'
                    : 'border-gray-300 bg-gray-50'
                }`}{{else}}style={[styles.box, (active || filled) && styles.boxActive]}{{/if}}
              >
                <Text {{#if (eq styling "nativewind")}}className="text-xl font-semibold text-gray-900"{{else}}style={styles.boxText}{{/if}}>
                  {code[i] ?? ''}
                </Text>
              </View>
            );
          })}
        </View>
        <TextInput
          ref={inputRef}
          value={code}
          onChangeText={handleChange}
          keyboardType="number-pad"
          maxLength={OTP_LENGTH}
          {{#if (eq styling "nativewind")}}className="absolute h-1 w-full opacity-0"{{else}}style={styles.hiddenInput}{{/if}}
          accessibilityLabel="One-time code"
        />
      </Pressable>

      {error && (
        <Text {{#if (eq styling "nativewind")}}className="text-sm text-red-500"{{else}}style={styles.errorText}{{/if}}>
          {error}
        </Text>
      )}

      <Pressable
        onPress={handleVerify}
        {{#if (eq styling "nativewind")}}className="mt-2 items-center rounded-xl bg-blue-600 py-4"{{else}}style={styles.button}{{/if}}
      >
        <Text {{#if (eq styling "nativewind")}}className="text-base font-semibold text-white"{{else}}style={styles.buttonText}{{/if}}>
          Verify
        </Text>
      </Pressable>

      <Pressable
        onPress={handleResend}
        {{#if (eq styling "nativewind")}}className="flex-row items-center justify-center gap-2 py-2"{{else}}style={styles.resend}{{/if}}
      >
        {{#if (eq icons "lucide")}}
        <RefreshCw size={16} color="#6B7280" />
        {{/if}}
        <Text {{#if (eq styling "nativewind")}}className="text-sm text-gray-500"{{else}}style={styles.resendText}{{/if}}>
          Resend code
        </Text>
      </Pressable>
    </View>
  );
}

{{#if (eq styling "stylesheet")}}
const styles = StyleSheet.create({
  container: {
    gap: 16,
  },
  boxesRow: {
    flexDirection: 'row',
    justifyContent: 'space-between',
  },
  box: {
    height: 56,
    width: 48,
    alignItems: 'center',
    justifyContent: 'center',
    borderWidth: 2,
    borderColor: '#D1D5DB',
    backgroundColor: '#F9FAFB',
    borderRadius: 12,
  },
  boxActive: {
    borderColor: '#3B82F6',
    backgroundColor: '#EFF6FF',
  },
  boxText: {
    fontSize: 20,
    fontWeight: '600',
    color: '#111827',
  },
  hiddenInput: {
    position: 'absolute',
    height: 4,
    width: '100%',
    opacity: 0,
  },
  errorText: {
    fontSize: 14,
    color: '#EF4444',
  },
  button: {
    marginTop: 8,
    alignItems: 'center',
    borderRadius: 12,
    backgroundColor: '#2563EB',
    paddingVertical: 16,
  },
  buttonText: {
    fontSize: 16,
    fontWeight: '600',
    color: '#FFFFFF',
  },
  resend: {
    flexDirection: 'row',
    alignItems: 'center',
    justifyContent: 'center',
    gap: 8,
    paddingVertical: 8,
  },
  resendText: {
    fontSize: 14,
    color: '#6B7280',
  },
});
{{/if}}