import { 
  View, 
  Text, 
  Pressable{{#if (eq styling "stylesheet")}}, 
  StyleSheet{{/if}} 
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
{{#if (eq icons "lucide")}}
import { TriangleAlert, RefreshCw } from 'lucide-react-native';
{{/if}}

export default function ErrorScreen() {
  return (
    <SafeAreaView {{#if (eq styling "nativewind")}}className="flex-1 bg-white"{{else}}style={styles.safeArea}{{/if}}>
      <View {{#if (eq styling "nativewind")}}className="flex-1 items-center justify-center px-8"{{else}}style={styles.container}{{/if}}>
        {{#if (eq icons "lucide")}}
        <View {{#if (eq styling "nativewind")}}className="h-24 w-24 items-center justify-center rounded-full bg-red-50"{{else}}style={styles.iconCircle}{{/if}}>
          <TriangleAlert size={40} color="#EF4444" />
        </View>
        {{else}}
        <View {{#if (eq styling "nativewind")}}className="h-24 w-24 items-center justify-center rounded-full bg-red-50"{{else}}style={styles.iconCircle}{{/if}}>
          <Text {{#if (eq styling "nativewind")}}className="text-4xl text-red-500"{{else}}style={styles.iconText}{{/if}}>!</Text>
        </View>
        {{/if}}
        <Text {{#if (eq styling "nativewind")}}className="mt-6 text-xl font-bold text-gray-900"{{else}}style={styles.title}{{/if}}>
          Something went wrong
        </Text>
        <Text {{#if (eq styling "nativewind")}}className="mt-2 text-center text-base text-gray-500"{{else}}style={styles.subtitle}{{/if}}>
          We couldn't load this content. Please try again.
        </Text>
        <Pressable
          onPress={() => console.log('retry')}
          {{#if (eq styling "nativewind")}}className="mt-8 flex-row items-center rounded-xl bg-blue-600 px-8 py-4"{{else}}style={styles.button}{{/if}}
        >
          {{#if (eq icons "lucide")}}
          <RefreshCw size={18} color="#FFFFFF" />
          {{/if}}
          <Text {{#if (eq styling "nativewind")}}className="ml-2 text-base font-semibold text-white"{{else}}style={styles.buttonText}{{/if}}>
            Try Again
          </Text>
        </Pressable>
      </View>
    </SafeAreaView>
  );
}

