import { useState } from 'react';
import { 
  View, 
  Text, 
  Pressable, 
  ScrollView{{#if (eq styling "stylesheet")}}, 
  StyleSheet{{/if}} 
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { useLocalSearchParams, useRouter } from 'expo-router';
{{#if (eq icons "lucide")}}
import { ChevronLeft, Star, ShoppingCart, Heart, Share2 } from 'lucide-react-native';
{{/if}}

export default function ProductDetailsScreen() {
  const params = useLocalSearchParams();
  const router = useRouter();
  const [quantity, setQuantity] = useState(1);
  const [favorite, setFavorite] = useState(false);

  const product = {
    title: 'Wireless Earbuds Pro',
    price: '$129.00',
    rating: 4.8,
    reviews: 1240,
    description:
      'Premium wireless earbuds with active noise cancellation, 30-hour battery life, and crystal-clear call quality.',
  };

  return (
    <SafeAreaView {{#if (eq styling "nativewind")}}className="flex-1 bg-white"{{else}}style={styles.safeArea}{{/if}} edges={['top']}>
      {/* Top bar */}
      <View {{#if (eq styling "nativewind")}}className="flex-row items-center justify-between px-5 pt-4"{{else}}style={styles.topBar}{{/if}}>
        {{#if (eq icons "lucide")}}
        <Pressable onPress={() => router.back()} {{#if (eq styling "nativewind")}}className="h-10 w-10 items-center justify-center rounded-full bg-gray-100"{{else}}style={styles.roundButton}{{/if}}>
          <ChevronLeft size={22} color="#111827" />
        </Pressable>
        <View {{#if (eq styling "nativewind")}}className="flex-row gap-3"{{else}}style={styles.topActions}{{/if}}>
          <Pressable onPress={() => setFavorite(!favorite)} {{#if (eq styling "nativewind")}}className="h-10 w-10 items-center justify-center rounded-full bg-gray-100"{{else}}style={styles.roundButton}{{/if}}>
            <Heart size={20} color={favorite ? '#EF4444' : '#111827'} fill={favorite ? '#EF4444' : 'none'} />
          </Pressable>
          <Pressable onPress={() => console.log('share')} {{#if (eq styling "nativewind")}}className="h-10 w-10 items-center justify-center rounded-full bg-gray-100"{{else}}style={styles.roundButton}{{/if}}>
            <Share2 size={20} color="#111827" />
          </Pressable>
        </View>
        {{/if}}
      </View>

      <ScrollView contentContainerStyle={styles.content}>
        {/* Image */}
        <View {{#if (eq styling "nativewind")}}className="mx-5 mt-4 h-72 items-center justify-center rounded-2xl bg-blue-50"{{else}}style={styles.image}{{/if}}>
          <View {{#if (eq styling "nativewind")}}className="h-40 w-40 rounded-3xl bg-blue-200"{{else}}style={styles.imageBlock}{{/if}} />
        </View>

        {/* Info */}
        <View {{#if (eq styling "nativewind")}}className="mt-6 px-5"{{else}}style={styles.info}{{/if}}>
          <View {{#if (eq styling "nativewind")}}className="flex-row items-center gap-2"{{else}}style={styles.ratingRow}{{/if}}>
            {{#if (eq icons "lucide")}}
            <Star size={16} color="#F59E0B" fill="#F59E0B" />
            {{/if}}
            <Text {{#if (eq styling "nativewind")}}className="text-sm font-medium text-gray-900"{{else}}style={styles.rating}{{/if}}>{product.rating}</Text>
            <Text {{#if (eq styling "nativewind")}}className="text-sm text-gray-400"{{else}}style={styles.reviews}{{/if}}>({product.reviews} reviews)</Text>
          </View>
          <Text {{#if (eq styling "nativewind")}}className="mt-2 text-2xl font-bold text-gray-900"{{else}}style={styles.title}{{/if}}>
            {product.title}
          </Text>
          <Text {{#if (eq styling "nativewind")}}className="mt-1 text-2xl font-bold text-blue-600"{{else}}style={styles.price}{{/if}}>
            {product.price}
          </Text>
          <Text {{#if (eq styling "nativewind")}}className="mt-4 text-base leading-6 text-gray-600"{{else}}style={styles.description}{{/if}}>
            {product.description}
          </Text>

          {/* Quantity */}
          <View {{#if (eq styling "nativewind")}}className="mt-6 flex-row items-center justify-between"{{else}}style={styles.quantityRow}{{/if}}>
            <Text {{#if (eq styling "nativewind")}}className="text-base font-medium text-gray-900"{{else}}style={styles.quantityLabel}{{/if}}>Quantity</Text>
            <View {{#if (eq styling "nativewind")}}className="flex-row items-center rounded-full bg-gray-100"{{else}}style={styles.quantityControl}{{/if}}>
              <Pressable
                onPress={() => setQuantity((q) => Math.max(1, q - 1))}
                {{#if (eq styling "nativewind")}}className="h-9 w-9 items-center justify-center"{{else}}style={styles.quantityButton}{{/if}}
              >
                <Text {{#if (eq styling "nativewind")}}className="text-xl text-gray-700"{{else}}style={styles.quantityButtonText}{{/if}}>−</Text>
              </Pressable>
              <Text {{#if (eq styling "nativewind")}}className="w-8 text-center text-base font-semibold text-gray-900"{{else}}style={styles.quantityValue}{{/if}}>{quantity}</Text>
              <Pressable
                onPress={() => setQuantity((q) => q + 1)}
                {{#if (eq styling "nativewind")}}className="h-9 w-9 items-center justify-center"{{else}}style={styles.quantityButton}{{/if}}
              >
                <Text {{#if (eq styling "nativewind")}}className="text-xl text-gray-700"{{else}}style={styles.quantityButtonText}{{/if}}>+</Text>
              </Pressable>
            </View>
          </View>
        </View>
      </ScrollView>

      {/* Add to cart */}
      <View {{#if (eq styling "nativewind")}}className="border-t border-gray-100 px-5 py-4"{{else}}style={styles.bottomBar}{{/if}}>
        <Pressable onPress={() => console.log('add to cart', { ...product, quantity })} {{#if (eq styling "nativewind")}}className="flex-row items-center justify-center rounded-xl bg-blue-600 py-4"{{else}}style={styles.addButton}{{/if}}>
          {{#if (eq icons "lucide")}}
          <ShoppingCart size={20} color="#FFFFFF" />
          {{/if}}
          <Text {{#if (eq styling "nativewind")}}className="ml-2 text-base font-semibold text-white"{{else}}style={styles.addButtonText}{{/if}}>
            Add to Cart
          </Text>
        </Pressable>
      </View>
    </SafeAreaView>
  );
}

