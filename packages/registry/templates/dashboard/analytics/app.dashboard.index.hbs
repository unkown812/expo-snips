import { 
  View, 
  Text, 
  ScrollView, 
  Pressable{{#if (eq styling "stylesheet")}}, 
  StyleSheet{{/if}} 
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
{{#if (eq icons "lucide")}}
import { TrendingUp, TrendingDown, Users, DollarSign, Activity, ArrowUpRight } from 'lucide-react-native';
{{/if}}

const stats = [
  { label: 'Revenue', value: '$12,345', change: '+12.5%', trend: 'up', icon: DollarSign, color: '#10B981' },
  { label: 'Users', value: '2,345', change: '+8.2%', trend: 'up', icon: Users, color: '#2563EB' },
  { label: 'Active', value: '1,234', change: '-2.1%', trend: 'down', icon: Activity, color: '#8B5CF6' },
];

const activity = [
  { id: '1', user: 'Sarah Wilson', action: 'made a purchase', time: '2m ago', amount: '$49.99' },
  { id: '2', user: 'Mike Chen', action: 'signed up', time: '15m ago', amount: null },
  { id: '3', user: 'Emma Davis', action: 'upgraded plan', time: '1h ago', amount: '$99.99' },
  { id: '4', user: 'Alex Kim', action: 'left a review', time: '3h ago', amount: null },
];

export default function DashboardScreen() {
  return (
    <SafeAreaView {{#if (eq styling "nativewind")}}className="flex-1 bg-gray-50"{{else}}style={styles.safeArea}{{/if}} edges={['top']}>
      <ScrollView contentContainerStyle={styles.content}>
        {/* Header */}
        <View {{#if (eq styling "nativewind")}}className="px-5 pt-4 pb-6"{{else}}style={styles.header}{{/if}}>
          <Text {{#if (eq styling "nativewind")}}className="text-2xl font-bold text-gray-900"{{else}}style={styles.headerTitle}{{/if}}>
            Dashboard
          </Text>
          <Text {{#if (eq styling "nativewind")}}className="mt-1 text-sm text-gray-500"{{else}}style={styles.headerSubtitle}{{/if}}>
            Overview of your analytics
          </Text>
        </View>

        {/* Stat Cards */}
        <View {{#if (eq styling "nativewind")}}className="gap-4 px-5"{{else}}style={styles.statsContainer}{{/if}}>
          {stats.map(({ label, value, change, trend{{#if (eq icons "lucide")}}, icon: Icon{{/if}}, color }) => (
            <View key={label} {{#if (eq styling "nativewind")}}className="rounded-2xl bg-white p-4"{{else}}style={styles.statCard}{{/if}}>
              <View {{#if (eq styling "nativewind")}}className="flex-row items-center justify-between"{{else}}style={styles.statHeader}{{/if}}>
                <View {{#if (eq styling "nativewind")}}className="flex-row items-center gap-2"{{else}}style={styles.statLabelRow}{{/if}}>
                  {{#if (eq icons "lucide")}}
                  <View {{#if (eq styling "nativewind")}}className="h-8 w-8 items-center justify-center rounded-lg"{{else}}style={[styles.statIcon, { backgroundColor: `${color}15` }]}{{/if}}>
                    <Icon size={16} color={color} />
                  </View>
                  {{/if}}
                  <Text {{#if (eq styling "nativewind")}}className="text-sm text-gray-500"{{else}}style={styles.statLabel}{{/if}}>{label}</Text>
                </View>
                {{#if (eq icons "lucide")}}
                <Pressable {{#if (eq styling "nativewind")}}className="h-6 w-6 items-center justify-center rounded-full bg-gray-100"{{else}}style={styles.moreButton}{{/if}}>
                  <ArrowUpRight size={12} color="#6B7280" />
                </Pressable>
                {{/if}}
              </View>
              <Text {{#if (eq styling "nativewind")}}className="mt-3 text-2xl font-bold text-gray-900"{{else}}style={styles.statValue}{{/if}}>
                {value}
              </Text>
              <View {{#if (eq styling "nativewind")}}className="mt-2 flex-row items-center"{{else}}style={styles.changeRow}{{/if}}>
                {{#if (eq icons "lucide")}}
                {trend === 'up' ? (
                  <TrendingUp size={14} color="#10B981" />
                ) : (
                  <TrendingDown size={14} color="#EF4444" />
                )}
                {{/if}}
                <Text {{#if (eq styling "nativewind")}}className={`ml-1 text-sm font-medium ${trend === 'up' ? 'text-green-600' : 'text-red-500'}`}{{else}}style={[styles.change, trend === 'up' ? styles.changeUp : styles.changeDown]}{{/if}}>
                  {change}
                </Text>
                <Text {{#if (eq styling "nativewind")}}className="ml-2 text-xs text-gray-400"{{else}}style={styles.changePeriod}{{/if}}>
                  vs last month
                </Text>
              </View>
            </View>
          ))}
        </View>

        {/* Chart Placeholder */}
        <View {{#if (eq styling "nativewind")}}className="mx-5 mt-6 rounded-2xl bg-white p-5"{{else}}style={styles.chartCard}{{/if}}>
          <Text {{#if (eq styling "nativewind")}}className="text-base font-semibold text-gray-900"{{else}}style={styles.chartTitle}{{/if}}>
            Revenue Trend
          </Text>
          <View {{#if (eq styling "nativewind")}}className="mt-4 h-40 items-center justify-center rounded-xl bg-gray-50"{{else}}style={styles.chartPlaceholder}{{/if}}>
            <Text {{#if (eq styling "nativewind")}}className="text-sm text-gray-400"{{else}}style={styles.chartPlaceholderText}{{/if}}>
              Chart goes here
            </Text>
          </View>
        </View>

        {/* Recent Activity */}
        <View {{#if (eq styling "nativewind")}}className="mt-6 px-5"{{else}}style={styles.activitySection}{{/if}}>
          <View {{#if (eq styling "nativewind")}}className="flex-row items-center justify-between"{{else}}style={styles.activityHeader}{{/if}}>
            <Text {{#if (eq styling "nativewind")}}className="text-base font-semibold text-gray-900"{{else}}style={styles.activityTitle}{{/if}}>
              Recent Activity
            </Text>
            <Pressable>
              <Text {{#if (eq styling "nativewind")}}className="text-sm text-blue-600"{{else}}style={styles.seeAll}{{/if}}>See all</Text>
            </Pressable>
          </View>
          <View {{#if (eq styling "nativewind")}}className="mt-3 gap-3"{{else}}style={styles.activityList}{{/if}}>
            {activity.map((item) => (
              <View key={item.id} {{#if (eq styling "nativewind")}}className="flex-row items-center rounded-xl bg-white p-4"{{else}}style={styles.activityCard}{{/if}}>
                <View {{#if (eq styling "nativewind")}}className="h-10 w-10 items-center justify-center rounded-full bg-gray-100"{{else}}style={styles.activityAvatar}{{/if}}>
                  <Text {{#if (eq styling "nativewind")}}className="text-sm font-medium text-gray-600"{{else}}style={styles.activityAvatarText}{{/if}}>
                    {item.user.charAt(0)}
                  </Text>
                </View>
                <View {{#if (eq styling "nativewind")}}className="ml-3 flex-1"{{else}}style={styles.activityContent}{{/if}}>
                  <Text {{#if (eq styling "nativewind")}}className="text-sm text-gray-900"{{else}}style={styles.activityText}{{/if}}>
                    <Text {{#if (eq styling "nativewind")}}className="font-medium"{{else}}style={styles.activityUser}{{/if}}>{item.user}</Text>
                    {' '}{item.action}
                  </Text>
                  <Text {{#if (eq styling "nativewind")}}className="mt-0.5 text-xs text-gray-400"{{else}}style={styles.activityTime}{{/if}}>
                    {item.time}
                  </Text>
                </View>
                {item.amount && (
                  <Text {{#if (eq styling "nativewind")}}className="text-sm font-semibold text-gray-900"{{else}}style={styles.activityAmount}{{/if}}>
                    {item.amount}
                  </Text>
                )}
              </View>
            ))}
          </View>
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}

