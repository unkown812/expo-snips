import { useState } from 'react';
import { 
  View, 
  Text, 
  TextInput, 
  Pressable, 
  FlatList{{#if (eq styling "stylesheet")}}, 
  StyleSheet{{/if}} 
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
{{#if (eq icons "lucide")}}
import { Search as SearchIcon, X, Clock } from 'lucide-react-native';
{{/if}}

const recentSearches = ['camera', 'wireless earbuds', 'running shoes', 'usb-c hub'];

const results = [
  { id: '1', title: 'Wireless Earbuds Pro', category: 'Electronics' },
  { id: '2', title: 'Running Shoes', category: 'Sports' },
  { id: '3', title: 'Smart Camera', category: 'Electronics' },
  { id: '4', title: 'USB-C Hub 7-in-1', category: 'Accessories' },
];

export default function SearchScreen() {
  const [query, setQuery] = useState('');
  const [submitted, setSubmitted] = useState(false);

  const submit = (value: string) => {
    const text = value.trim();
    if (!text) return;
    setQuery(text);
    setSubmitted(true);
  };

  return (
    <SafeAreaView {{#if (eq styling "nativewind")}}className="flex-1 bg-white"{{else}}style={styles.safeArea}{{/if}} edges={['top']}>
      <View {{#if (eq styling "nativewind")}}className="px-5 pt-4"{{else}}style={styles.header}{{/if}}>
        <Text {{#if (eq styling "nativewind")}}className="text-2xl font-bold text-gray-900"{{else}}style={styles.title}{{/if}}>
          Search
        </Text>
        <View {{#if (eq styling "nativewind")}}className="mt-4 flex-row items-center rounded-xl bg-gray-100 px-4"{{else}}style={styles.searchBar}{{/if}}>
          {{#if (eq icons "lucide")}}
          <SearchIcon size={20} color="#6B7280" />
          {{/if}}
          <TextInput
            value={query}
            onChangeText={setQuery}
            onSubmitEditing={() => submit(query)}
            returnKeyType="search"
            placeholder="Search products"
            placeholderTextColor="#9CA3AF"
            autoCapitalize="none"
            {{#if (eq styling "nativewind")}}className="ml-3 flex-1 py-3 text-gray-900"{{else}}style={styles.searchInput}{{/if}}
          />
          {query.length > 0 && (
            <Pressable onPress={() => { setQuery(''); setSubmitted(false); }}>
              {{#if (eq icons "lucide")}}
              <X size={18} color="#6B7280" />
              {{else}}
              <Text {{#if (eq styling "nativewind")}}className="text-lg text-gray-500"{{else}}style={styles.clearText}{{/if}}>×</Text>
              {{/if}}
            </Pressable>
          )}
        </View>
      </View>

      {!submitted ? (
        <View {{#if (eq styling "nativewind")}}className="px-5 pt-6"{{else}}style={styles.recentSection}{{/if}}>
          <Text {{#if (eq styling "nativewind")}}className="text-base font-semibold text-gray-900"{{else}}style={styles.sectionTitle}{{/if}}>
            Recent
          </Text>
          <View {{#if (eq styling "nativewind")}}className="mt-3 flex-row flex-wrap gap-2"{{else}}style={styles.chips}{{/if}}>
            {recentSearches.map((term) => (
              <Pressable
                key={term}
                onPress={() => submit(term)}
                {{#if (eq styling "nativewind")}}className="flex-row items-center rounded-full bg-gray-100 px-4 py-2"{{else}}style={styles.chip}{{/if}}
              >
                {{#if (eq icons "lucide")}}
                <Clock size={14} color="#6B7280" />
                {{/if}}
                <Text {{#if (eq styling "nativewind")}}className="ml-1.5 text-sm text-gray-700"{{else}}style={styles.chipText}{{/if}}>{term}</Text>
              </Pressable>
            ))}
          </View>
        </View>
      ) : (
        <FlatList
          data={results}
          keyExtractor={(item) => item.id}
          contentContainerStyle={styles.resultsContent}
          ListHeaderComponent={
            <Text {{#if (eq styling "nativewind")}}className="px-5 pb-3 text-base font-semibold text-gray-900"{{else}}style={styles.sectionTitle}{{/if}}>
              Results for "{query}"
            </Text>
          }
          renderItem={({ item }) => (
            <Pressable {{#if (eq styling "nativewind")}}className="border-b border-gray-100 px-5 py-4"{{else}}style={styles.resultItem}{{/if}}>
              <Text {{#if (eq styling "nativewind")}}className="text-base text-gray-900"{{else}}style={styles.resultTitle}{{/if}}>{item.title}</Text>
              <Text {{#if (eq styling "nativewind")}}className="mt-0.5 text-sm text-gray-400"{{else}}style={styles.resultCategory}{{/if}}>{item.category}</Text>
            </Pressable>
          )}
        />
      )}
    </SafeAreaView>
  );
}

{{#if (eq styling "stylesheet")}}
const styles = StyleSheet.create({
  safeArea: {
    flex: 1,
    backgroundColor: '#FFFFFF',
  },
  header: {
    paddingHorizontal: 20,
    paddingTop: 16,
  },
  title: {
    fontSize: 24,
    fontWeight: 'bold',
    color: '#111827',
  },
  searchBar: {
    marginTop: 16,
    flexDirection: 'row',
    alignItems: 'center',
    borderRadius: 12,
    backgroundColor: '#F3F4F6',
    paddingHorizontal: 16,
  },
  searchInput: {
    marginLeft: 12,
    flex: 1,
    paddingVertical: 12,
    color: '#111827',
  },
  clearText: {
    fontSize: 18,
    color: '#6B7280',
  },
  recentSection: {
    paddingHorizontal: 20,
    paddingTop: 24,
  },
  sectionTitle: {
    fontSize: 16,
    fontWeight: '600',
    color: '#111827',
  },
  chips: {
    marginTop: 12,
    flexDirection: 'row',
    flexWrap: 'wrap',
    gap: 8,
  },
  chip: {
    flexDirection: 'row',
    alignItems: 'center',
    borderRadius: 20,
    backgroundColor: '#F3F4F6',
    paddingHorizontal: 16,
    paddingVertical: 8,
  },
  chipText: {
    marginLeft: 6,
    fontSize: 14,
    color: '#374151',
  },
  resultsContent: {
    paddingTop: 24,
    paddingBottom: 24,
  },
  resultItem: {
    borderBottomWidth: 1,
    borderBottomColor: '#F3F4F6',
    paddingHorizontal: 20,
    paddingVertical: 16,
  },
  resultTitle: {
    fontSize: 16,
    color: '#111827',
  },
  resultCategory: {
    marginTop: 2,
    fontSize: 14,
    color: '#9CA3AF',
  },
});
{{/if}}