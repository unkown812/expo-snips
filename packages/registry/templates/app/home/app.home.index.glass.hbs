import { 
  View, 
  Text, 
  Pressable, 
  ScrollView, 
  RefreshControl,
  StyleSheet 
} from 'react-native';
import { SafeAreaView } from 'react-native-safe-area-context';
import { BlurView } from 'expo-blur';
{{#if (eq icons "lucide")}}
import { Bell, Search, ChevronRight, TrendingUp } from 'lucide-react-native';
{{/if}}

{{#if (eq icons "lucide")}}
const stats = [
  { label: 'Active Streak', value: '12', icon: TrendingUp, delta: '+2 today' },
  { label: 'Tasks Done', value: '48', icon: Search, delta: 'this week' },
];
{{else}}
const stats = [
  { label: 'Active Streak', value: '12', delta: '+2 today' },
  { label: 'Tasks Done', value: '48', delta: 'this week' },
];
{{/if}}

const upcoming = [
  { title: 'Morning workout', time: '7:00 AM', done: false },
  { title: 'Team standup', time: '9:30 AM', done: false },
  { title: 'Read for 20 minutes', time: '8:00 PM', done: true },
];

export default function HomeScreen() {
  return (
    <SafeAreaView style={styles.safeArea} edges={['top']}>
      <ScrollView
        contentContainerStyle={styles.content}
        refreshControl={
          <RefreshControl refreshing={false} onRefresh={() => console.log('refresh')} />
        }
      >
        <View style={styles.header}>
          <View>
            <Text style={styles.greeting}>
              Good morning
            </Text>
            <Text style={styles.headerTitle}>
              Jane
            </Text>
          </View>
          <View style={styles.headerActions}>
            {{#if (eq icons "lucide")}}
            <Pressable style={styles.iconButton}>
              <Bell size={20} color="#FFFFFF" />
            </Pressable>
            <Pressable style={styles.iconButton}>
              <Search size={20} color="#FFFFFF" />
            </Pressable>
            {{/if}}
          </View>
        </View>

        <View style={styles.statsRow}>
          {stats.map(({ label, value{{#if (eq icons "lucide")}}, icon: Icon{{/if}}, delta }) => (
            <BlurView key={label} intensity={15} tint="dark" style={styles.statCard}>
              <View style={styles.statHeader}>
                {{#if (eq icons "lucide")}}
                <Icon size={16} color="#60A5FA" />
                {{/if}}
                <Text style={styles.statLabel}>{label}</Text>
              </View>
              <Text style={styles.statValue}>{value}</Text>
              <Text style={styles.statDelta}>{delta}</Text>
            </BlurView>
          ))}
        </View>

        <View style={styles.section}>
          <View style={styles.sectionHeader}>
            <Text style={styles.sectionTitle}>
              Up next
            </Text>
            <Pressable style={styles.seeAll}>
              <Text style={styles.seeAllText}>See all</Text>
              {{#if (eq icons "lucide")}}
              <ChevronRight size={16} color="#60A5FA" />
              {{/if}}
            </Pressable>
          </View>

          <View style={styles.taskList}>
            {upcoming.map((task) => (
              <BlurView key={task.title} intensity={10} tint="dark" style={styles.taskCard}>
                <View
                  style={[styles.taskCheck, task.done && styles.taskCheckDone]}
                />
                <View style={styles.taskBody}>
                  <Text
                    style={[styles.taskTitle, task.done && styles.taskTitleDone]}
                  >
                    {task.title}
                  </Text>
                  <Text style={styles.taskTime}>{task.time}</Text>
                </View>
              </BlurView>
            ))}
          </View>
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}

