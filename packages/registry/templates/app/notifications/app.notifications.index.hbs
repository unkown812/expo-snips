            </Text>
          </View>
          <Pressable onPress={() => console.log('mark all read')}>
            <Text {{#if (eq styling "nativewind")}}className="text-sm text-blue-600"{{else}}style={styles.markAll}{{/if}}>Mark all read</Text>
          </Pressable>
        </View>

        {/* List */}
        <View {{#if (eq styling "nativewind")}}className="gap-3 px-5"{{else}}style={styles.list}{{/if}}>
          {notifications.map((notification) => (
            <Pressable
              key={notification.id}
              {{#if (eq styling "nativewind")}}className={`rounded-2xl p-4 ${notification.read ? 'bg-white' : 'bg-blue-50'}`}{{else}}style={[styles.card, !notification.read && styles.cardUnread]}{{/if}}
            >
              <View {{#if (eq styling "nativewind")}}className="flex-row items-center justify-between"{{else}}style={styles.cardHeader}{{/if}}>
                <Text
                  {{#if (eq styling "nativewind")}}className={`flex-1 text-base font-semibold ${notification.read ? 'text-gray-900' : 'text-blue-900'}`}{{else}}style={styles.cardTitle}{{/if}}
                >
                  {notification.title}
                </Text>
                {!notification.read && (
                  <View {{#if (eq styling "nativewind")}}className="ml-2 h-2 w-2 rounded-full bg-blue-600"{{else}}style={styles.unreadDot}{{/if}} />
                )}
              </View>
              <Text {{#if (eq styling "nativewind")}}className="mt-1 text-sm text-gray-600"{{else}}style={styles.cardMessage}{{/if}}>
                {notification.message}
              </Text>
              <Text {{#if (eq styling "nativewind")}}className="mt-2 text-xs text-gray-400"{{else}}style={styles.cardTime}{{/if}}>
                {notification.time}
              </Text>
            </Pressable>
          ))}
        </View>
      </ScrollView>
    </SafeAreaView>
  );
}

