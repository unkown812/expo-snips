export default function NotificationsScreen() {
  return (
    <SafeAreaView {{#if (eq styling "nativewind")}}className="flex-1 bg-gray-50"{{else}}style={styles.safeArea}{{/if}} edges={['top']}>
      <ScrollView contentContainerStyle={styles.content}>
        {/* Header */}
        <View {{#if (eq styling "nativewind")}}className="flex-row items-center justify-between px-5 pt-4 pb-6"{{else}}style={styles.header}{{/if}}>
          <View {{#if (eq styling "nativewind")}}className="flex-row items-center"{{else}}style={styles.headerLeft}{{/if}}>
            {{#if (eq icons "lucide")}}
            <Link href="/" {{#if (eq styling "nativewind")}}className="h-10 w-10 items-center justify-center rounded-full bg-white"{{else}}style={styles.backButton}{{/if}}>
              <ChevronLeft size={22} color="#111827" />
            </Link>
            {{/if}}
            <Text {{#if (eq styling "nativewind")}}className="ml-3 text-2xl font-bold text-gray-900"{{else}}style={styles.headerTitle}{{/if}}>
