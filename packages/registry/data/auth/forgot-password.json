{
  "id": "auth/forgot-password",
  "name": "Forgot Password Screen",
  "description": "Email submission to reset a forgotten password.",
  "version": "0.2.0",
  "framework": "react-native",
  "runtime": "expo",
  "typescript": true,
  "supported": {
    "styling": ["nativewind", "stylesheet"],
    "router": ["expo-router"],
    "ui": ["native", "shadcn"],
    "icons": ["lucide", "none"]
  },
  "dependencies": [
    "react-hook-form",
    "zod",
    "@hookform/resolvers",
    "lucide-react-native"
  ],
  "devDependencies": [],
  "files": [
    {
      "path": "app/forgot-password/index.tsx",
      "when": { "router": ["expo-router"], "ui": ["native"] },
      "templateFile": "auth/forgot-password/app.forgot-password.index.hbs"
    },
    {
      "path": "app/forgot-password/index.tsx",
      "when": { "router": ["expo-router"], "ui": ["shadcn"], "icons": ["lucide"] },
      "templateFile": "auth/forgot-password/app.forgot-password.index.shadcn.hbs"
    },
    {
      "path": "components/ForgotPasswordForm.tsx",
      "when": { "ui": ["native"] },
      "templateFile": "auth/forgot-password/components.forgot-password-form.hbs"
    },
    {
      "path": "components/ForgotPasswordForm.tsx",
      "when": { "ui": ["shadcn"], "icons": ["lucide"] },
      "templateFile": "auth/forgot-password/components.forgot-password-form.shadcn.hbs"
    }
  ],
  "variants": [],
  "tags": ["auth", "forgot-password", "form"],
  "primitives": ["ui/utils", "ui/button", "ui/input"]
}