{
  "id": "calendar/schedule",
  "name": "Calendar Schedule Screen",
  "description": "Monthly calendar grid with event dots and a scrollable event list below.",
  "version": "0.1.0",
  "framework": "react-native",
  "runtime": "expo",
  "typescript": true,
  "supported": {
    "styling": ["nativewind", "stylesheet"],
    "router": ["expo-router"],
    "ui": ["native"],
    "icons": ["lucide", "none"]
  },
  "dependencies": [
    "lucide-react-native"
  ],
  "devDependencies": [],
  "files": [
    {
      "path": "app/calendar/index.tsx",
      "when": { "router": ["expo-router"], "ui": ["native"] },
      "templateFile": "calendar/schedule/app.calendar.index.hbs"
    },
    {
      "path": "components/EventItem.tsx",
      "when": { "ui": ["native"] },
      "templateFile": "calendar/schedule/components.event-item.hbs"
    }
  ],
  "variants": [],
  "tags": ["calendar", "schedule", "events", "planner"],
  "primitives": []
}
