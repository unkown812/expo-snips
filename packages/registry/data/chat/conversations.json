{
  "id": "chat/conversations",
  "name": "Chat Conversations List",
  "description": "Conversation list with avatars, last message preview, timestamps and unread badges.",
  "version": "0.1.0",
  "framework": "react-native",
  "runtime": "expo",
  "typescript": true,
  "supported": {
    "styling": ["nativewind", "stylesheet"],
    "router": ["expo-router"],
    "ui": ["native"],
    "icons": ["lucide", "none"]
  },
  "dependencies": [
    "lucide-react-native"
  ],
  "devDependencies": [],
  "files": [
    {
      "path": "app/chat/index.tsx",
      "when": { "router": ["expo-router"], "ui": ["native"] },
      "templateFile": "chat/conversations/app.chat.index.hbs"
    },
    {
      "path": "components/ConversationItem.tsx",
      "when": { "ui": ["native"] },
      "templateFile": "chat/conversations/components.conversation-item.hbs"
    }
  ],
  "variants": [],
  "tags": ["chat", "messages", "conversations", "list"],
  "primitives": []
}
