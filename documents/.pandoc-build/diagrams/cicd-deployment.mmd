flowchart LR
  subgraph W1["deploy-registry.yml"]
    A["push to main / master<br/>or workflow_dispatch"] --> B["checkout + setup-node 20"]
    B --> C["node scripts/build-registry.mjs"]
    C --> D["mkdir public; cp -R registry public/registry"]
    D --> E["peaceiris/actions-gh-pages@v3<br/>publish_dir ./public"]
